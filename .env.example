# ─── Supabase ─────────────────────────────────────────────────────────────────
# Your project URL from Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co

# Server-side service role key — NEVER expose to Flutter or public clients
# Supabase dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Public anon key — safe to share with frontend (Row Level Security protects data)
# Supabase dashboard → Settings → API → anon
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── AI Providers ─────────────────────────────────────────────────────────────
# Primary: Qwen3-VL via vLLM on AWS GPU
# Set LLM_PROVIDER=qwen to use Qwen (default), =gemini to use Gemini as primary
LLM_PROVIDER=qwen

# Your AWS EC2 vLLM server URL (e.g. http://54.x.x.x:8000 or https://your-domain.com)
VLLM_BASE_URL=

# Optional API key to protect vLLM endpoint (set in vLLM --api-key flag)
VLLM_API_KEY=

# Fallback: Google Gemini API Key
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ─── Sarvam AI (speech-to-text + translation) ──────────────────────────────
# Server-side only — NEVER expose to the frontend.
# https://dashboard.sarvam.ai/
SARVAM_API_KEY=
# Optional overrides (defaults are sane):
# SARVAM_BASE_URL=https://api.sarvam.ai
# SARVAM_SPEECH_MODEL=saaras:v3
# SARVAM_SPEECH_MODE=transcribe
# SARVAM_TRANSLATION_MODEL=mayura:v1

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Development example:
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080
# Production example:
# CORS_ORIGINS=https://artisanlink.app,https://www.artisanlink.app

# ─── Application ──────────────────────────────────────────────────────────────
# Set to 'production' to suppress internal error details in responses
ENVIRONMENT=development
